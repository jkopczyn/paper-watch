[Unit]
Description=paper-watch digest run
# Any nonzero exit (crash, SMTP auth failure, missing .env, broken uv) fires
# the alert unit, which logs to paper-watch-alerts.log and fans out to the
# channels in config.yaml `alerts:`. %p passes the unit prefix ("paper-watch") through.
OnFailure=paper-watch-alert@%p.service

[Service]
Type=oneshot
# %h expands to the user's home, so these units work for any user without
# hardcoding a username.
WorkingDirectory=%h/Code/paper-watch
# uv lives in the user's ~/.local/bin, which is not on the PATH that systemd
# uses, so call it by absolute path.
ExecStart=%h/.local/bin/uv run paper-watch run
# Output goes to the journal: journalctl --user -u paper-watch
